---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { evidenceImages } from '../lib/images';

interface Props {
  app: string;
  version: string;
  headline: string;
  summary: string;
  caveat: string;
  imageFile: string;
  imageAlt: string;
  pathLabel: string;
  docsHref: string;
  portrait?: boolean;
}

const { app, version, headline, summary, caveat, imageFile, imageAlt, pathLabel, docsHref, portrait = false } =
  Astro.props;
const image = evidenceImages[imageFile];
---

<article class="glass glass--soft evidence-card sheen reveal">
  <div class:list={['evidence-card__media', portrait && 'evidence-card__media--phone']}>
    {image && (
      <Image
        src={image}
        alt={imageAlt}
        widths={portrait ? [320, 480, 720] : [480, 720, 1120]}
        sizes={portrait ? '(max-width: 660px) 60vw, 240px' : '(max-width: 660px) 90vw, (max-width: 1000px) 42vw, 340px'}
        format="webp"
        quality={82}
        loading="lazy"
        decoding="async"
      />
    )}
    <span class="evidence-card__path">{pathLabel}</span>
  </div>
  <div class="evidence-card__body">
    <div class="evidence-card__title">
      <h3>{app}</h3>
      <span>{version}</span>
    </div>
    <p><strong>{headline}</strong></p>
    <p>{summary}</p>
    <p class="evidence-card__caveat">{caveat}</p>
    <div class="evidence-card__foot">
      <a class="text-link" href={docsHref} rel="noopener">
        Read the evidence
        <Icon name="arrow-up-right" size={14} />
      </a>
    </div>
  </div>
</article>
