/target
**/*.rs.bk
*.sock
*.pid
*.log
fixtures/*/lib/
fixtures/*/*.apk
fixtures/egl-app/egl-app
fixtures/opensl-app/opensl-app

# Built C fixtures (run their build.sh)
fixtures/*/libmain.so
fixtures/*/*.o

# Generated H.264 probe stream (tools/make_h264.py is deterministic)
fixtures/*.h264
/tmp/*.h264

# Local build environment: a private rustup + compiler bridge used on hosts that
# have no system Rust/gcc. Never part of the repo.
/.toolchain
/.cargo

# App packages dropped in for testing (plain APKs and Play bundles). These are
# multi-hundred-MB binaries and must never be committed.
/*.apk
/*.apkm
/*.apkx
/*.xapk
/*.apks

# ExoPlayer cache dumps written by the guest at runtime.
exoplayer/

# Video frames dumped by PENGUDROID_DUMP_VIDEO.
/tmp/vid-*.ppm
vid-*.png
