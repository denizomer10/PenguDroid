import { ScrollView, CheckBox, Button, TextEdit } from "std-widgets.slint";

export struct AppEntry {
    package: string,
    label: string,
    activity: string,
    running: bool,
    stopping: bool,
    icon: image,
    has-icon: bool,
}

component AppIcon inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon;
    border-radius: 12px;
    background: #303641;
    if root.has-icon : Image { width: 100%; height: 100%; source: root.icon; image-fit: contain; }
    if !root.has-icon : Text {
        text: "◇"; color: #aab9d3; font-size: 25px;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

export component KeymapWindow inherits Window {
    title: "Keymapper · PenguDroid";
    preferred-width: 620px; preferred-height: 520px;
    background: #151921;
    in-out property <string> profile;
    in property <string> app-name;
    in property <string> message: "Use Linux key names and app pixel coordinates.";
    callback save-profile(string);
    VerticalLayout {
        padding: 24px; spacing: 16px;
        Text { text: "Controls for " + root.app-name; color: #f2f5fa; font-size: 23px; font-weight: 700; }
        Text {
            text: "W = hold 120 900\nSPACE = tap 650 1100\nSHIFT = swipe 100 500 400 500 12";
            color: #a7b4c8; font-size: 13px;
        }
        TextEdit { text <=> root.profile; vertical-stretch: 1; }
        Text { text: root.message; color: #a7b4c8; wrap: word-wrap; }
        Button { text: "Save controls"; clicked => { root.save-profile(root.profile); } }
    }
}

export component MainWindow inherits Window {
    title: "PenguDroid";
    preferred-width: 1120px; preferred-height: 740px;
    min-width: 860px; min-height: 580px;
    background: #11151d;
    in property <[AppEntry]> apps;
    in-out property <int> selected: -1;
    in property <bool> keymapper-on: false;
    in property <bool> fps-meter-on: false;
    in property <string> status: "Your Android library, on Linux.";
    in property <bool> confirm-close: false;
    in property <int> running-count: 0;
    in-out property <bool> installing: false;
    in-out property <bool> quit-when-stopped: false;
    private property <bool> valid: root.selected >= 0 && root.selected < root.apps.length;

    callback install-requested();
    callback selection-changed(int);
    callback launch-requested(int);
    callback stop-requested(int);
    callback uninstall-requested(int);
    callback keymapper-toggled(bool);
    callback fps-meter-toggled(bool);
    callback edit-keymap();
    callback confirm-close-yes();
    callback confirm-close-no();

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 340px; background: #191f29;
            VerticalLayout {
                padding: 22px; spacing: 20px;
                HorizontalLayout {
                    spacing: 12px;
                    Image { width: 38px; height: 38px; source: @image-url("../../../logo.png"); image-fit: contain; }
                    VerticalLayout {
                        spacing: 1px; alignment: center;
                        Text { text: "PenguDroid"; color: #f4f7fb; font-size: 21px; font-weight: 700; }
                        Text { text: "ANDROID ON YOUR DESKTOP"; color: #8d9bb0; font-size: 9px; }
                    }
                }
                Button { text: root.installing ? "Installing…" : "+ Install a package"; enabled: !root.installing; clicked => { root.install-requested(); } }
                HorizontalLayout {
                    Text { text: "YOUR LIBRARY"; color: #91a1b9; font-size: 11px; font-weight: 600; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.apps.length; color: #91a1b9; font-size: 11px; }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 8px;
                        for app[i] in root.apps : Rectangle {
                            height: 82px; border-radius: 14px;
                            background: root.selected == i ? #2a3850 : row-touch.has-hover ? #222c3b : #1d2532;
                            border-width: 1px; border-color: root.selected == i ? #5d8dca : #273243;
                            HorizontalLayout {
                                padding: 12px; spacing: 12px;
                                AppIcon { width: 48px; height: 48px; icon: app.icon; has-icon: app.has-icon; }
                                VerticalLayout {
                                    alignment: center; spacing: 5px;
                                    Text { text: app.label; color: #f1f4fa; font-size: 14px; font-weight: 600; overflow: elide; }
                                    Text {
                                        text: app.stopping ? "Stopping…" : app.running ? "● Running" : "Ready to launch";
                                        color: app.running ? #72deb3 : #8e9db2; font-size: 11px;
                                    }
                                }
                            }
                            row-touch := TouchArea { clicked => { root.selected = i; root.selection-changed(i); } }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                Text { text: "APK · APKM · XAPK · APKS"; color: #74849a; font-size: 10px; }
            }
        }
        Rectangle {
            background: #11151d;
            VerticalLayout {
                padding: 36px; spacing: 24px;
                if root.valid : VerticalLayout {
                    spacing: 24px;
                    Text { text: "APPLICATION"; color: #7e91ac; font-size: 11px; font-weight: 600; }
                    HorizontalLayout {
                        spacing: 20px;
                        AppIcon { width: 84px; height: 84px; icon: root.apps[root.selected].icon; has-icon: root.apps[root.selected].has-icon; }
                        VerticalLayout {
                            alignment: center; spacing: 8px;
                            Text { text: root.apps[root.selected].label; color: #f5f7fc; font-size: 30px; font-weight: 700; overflow: elide; }
                            Text { text: root.apps[root.selected].package; color: #8f9eb4; font-size: 12px; overflow: elide; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Button {
                            text: root.apps[root.selected].running ? "Running" : "Launch app";
                            enabled: !root.apps[root.selected].running && !root.apps[root.selected].stopping;
                            clicked => { root.launch-requested(root.selected); }
                        }
                        Button {
                            text: root.apps[root.selected].stopping ? "Stopping…" : "Stop app";
                            enabled: root.apps[root.selected].running && !root.apps[root.selected].stopping;
                            clicked => { root.stop-requested(root.selected); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Rectangle {
                        border-radius: 16px; background: #1a2230; border-width: 1px; border-color: #2a3546;
                        VerticalLayout {
                            padding: 22px; spacing: 20px;
                            Text { text: "App preferences"; color: #e9eff9; font-size: 17px; font-weight: 600; }
                            Text { text: "Saved separately for this application."; color: #91a2bc; font-size: 12px; }
                            CheckBox { text: "Show FPS meter"; checked: root.fps-meter-on; toggled => { root.fps-meter-toggled(self.checked); } }
                            CheckBox { text: "Enable keymapper profile"; checked: root.keymapper-on; toggled => { root.keymapper-toggled(self.checked); } }
                            Button { text: "Configure controls"; clicked => { root.edit-keymap(); } }
                        }
                    }
                    Rectangle { height: 1px; background: #293242; }
                    HorizontalLayout {
                        Text { text: root.apps[root.selected].activity; color: #6e819e; font-size: 11px; overflow: elide; }
                        Button { text: "Uninstall"; enabled: !root.apps[root.selected].stopping; clicked => { root.uninstall-requested(root.selected); } }
                    }
                }
                if !root.valid : VerticalLayout {
                    alignment: center; spacing: 18px;
                    Text { text: "Make room for your apps."; color: #f0f4fc; font-size: 30px; font-weight: 700; }
                    Text { text: "Install an Android package to add it to your library."; color: #8d9fb9; wrap: word-wrap; }
                    Button { text: "Install your first app"; enabled: !root.installing; clicked => { root.install-requested(); } }
                }
                Rectangle { vertical-stretch: 1; }
                Rectangle {
                    border-radius: 10px; background: #192230;
                    VerticalLayout { padding: 14px; Text { text: root.status; color: #a9b9d0; font-size: 12px; wrap: word-wrap; } }
                }
            }
        }
    }
    if root.confirm-close : Rectangle {
        background: #080c16d0;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 440px; border-radius: 18px; background: #202b3c;
                VerticalLayout {
                    padding: 28px; spacing: 18px;
                    Text { text: "Close PenguDroid?"; color: #f4f7fc; font-size: 24px; font-weight: 700; }
                    Text { text: root.running-count + " running app(s) will be stopped."; color: #aebed5; wrap: word-wrap; }
                    HorizontalLayout {
                        Button { text: "Keep open"; clicked => { root.confirm-close-no(); } }
                        Button { text: "Close all apps"; clicked => { root.confirm-close-yes(); } }
                    }
                }
            }
        }
    }
}
